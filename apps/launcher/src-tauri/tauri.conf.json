{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WinWing Vibration Bridge",
  "version": "0.1.0",
  "identifier": "community.winwing.msfs2024-vibration-bridge",
  "build": {
    "beforeDevCommand": "node ../../scripts/ensure-bridge-host.js && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node ../../scripts/ensure-bridge-host.js --force && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "WinWing MSFS Vibration Bridge",
        "width": 1180,
        "height": 760,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "externalBin": [
      "binaries/bridge-host"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {}
}
